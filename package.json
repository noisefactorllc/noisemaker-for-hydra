{
  "name": "noisemaker-for-hydra",
  "version": "1.5.3",
  "type": "module",
  "description": "Hydra live-coding editor powered exclusively by the Noisemaker shader engine",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs && node scripts/test.mjs",
    "test:parity": "CHROME=${CHROME:-/usr/bin/chromium} node scripts/parity-gate.mjs parity-evidence",
    "build": "vite build",
    "dev": "vite . --host",
    "publish": "git subtree push --prefix=dist origin gh-pages"
  },
  "author": "",
  "license": "AGPL",
  "dependencies": {
    "@codemirror/lang-javascript": "^6.1.9",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@lezer/highlight": "^1.1.6",
    "@management/cm-evaluate": "^0.1.0",
    "assert": "^1.5.0",
    "buffer": "^5.2.1",
    "choo": "^7.1.0",
    "choo-devtools": "^3.0.4",
    "codemirror": "^6.0.1",
    "codemirror-minified": "^5.65.0",
    "events": "^3.3.0",
    "i18next": "^21.6.13",
    "i18next-browser-languagedetector": "^6.1.3",
    "js-beautify": "^1.14.0",
    "shortid": "^2.2.16",
    "simple-peer": "^9.11.0",
    "socket.io-client": "^2.3.0",
    "superagent": "^7.0.1"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "source-map-explorer": "^2.5.2",
    "terser": "^5.14.2",
    "vite": "^6.4.3"
  }
}
